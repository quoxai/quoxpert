    "quoxpert-cli": {
      "skill_md": "plugin/skills/quoxpert-cli/SKILL.md",
      "sources": [
        {
          "id": "cli-command-map",
          "repo": "quox-dashboard",
          "type": "cmd",
          "cmd": "node ../quoxpert/scripts/extract-cli-commands.mjs cli/lib/commands --format=table",
          "note": "QSDK-SKILLS audit fix 2026-07-25: this used to be a file-section pull of a \"CLI Commands (QuoxCLI)\" heading in CODEBASE_MAP.md that never existed (verified via grep), so it was silently unfetchable. Repointed at scripts/extract-cli-commands.mjs, which parses the real Commander.js `.command()`/`.description()` definitions straight out of cli/lib/commands/*.js (55 command-group files), more robust than depending on a hand-maintained doc table staying in sync, and it doesn't require running the CLI itself.",
          "feeds": [
            "command-map"
          ],
          "stamp": {
            "sha256": "012b0db43122bf1cb327387048f1ecf7aa38b088d9db267ebd7408c3a6630f34",
